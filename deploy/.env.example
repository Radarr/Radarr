# Copy to .env and fill in. Do NOT commit .env.

# --- Host user (so files Radarr writes are owned by you, not root) ---
PUID=1000
PGID=1000
TZ=America/New_York

# --- Storage on the host ---
# These get mounted into Radarr at /movies and /downloads.
MOVIES_PATH=./data/movies
DOWNLOADS_PATH=./data/downloads

# --- Radarr API (fill in AFTER first launch: Settings -> General -> API Key) ---
RADARR_API_KEY=

# --- Defaults the importer uses when adding movies ---
# Find the IDs by hitting these endpoints once Radarr is up:
#   curl -H "X-Api-Key: $RADARR_API_KEY" http://localhost:7878/api/v3/qualityprofile
#   curl -H "X-Api-Key: $RADARR_API_KEY" http://localhost:7878/api/v3/rootfolder
QUALITY_PROFILE_ID=1
ROOT_FOLDER_PATH=/movies
MIN_AVAILABILITY=released
SEARCH_ON_ADD=true
